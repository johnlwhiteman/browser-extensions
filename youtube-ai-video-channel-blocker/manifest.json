{
  "manifest_version": 3,
  "name": "John's YouTube AI Video Channel Blocker",
  "version": "1.5.0",
  "description": "Hides AI-labeled YouTube videos, and lets you block any video or channel.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "John's YouTube AI Video Channel Blocker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "options_ui": {
    "page": "manage.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  }
}